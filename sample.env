PAYLOAD_SECRET=
DATABASE_URI=mongodb://127.0.0.1:27017/titantech
NEXT_PUBLIC_URL=http://localhost:3000

# Vercel Blob — when unset, media falls back to local disk (public/media)
BLOB_READ_WRITE_TOKEN=

# Resend — when unset, Payload logs emails to the console instead of sending
RESEND_API_KEY=
EMAIL_FROM=quotes@titantechcnc.com
EMAIL_FROM_NAME=Titantech CNC
QUOTE_NOTIFICATION_EMAIL=titantechcnc@gmail.com
